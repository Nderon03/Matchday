# Public client configuration (safe to embed in the app). NEVER put service-role or Stripe secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: web origin used to build shareable invite links (defaults to the matchday:// scheme)
EXPO_PUBLIC_APP_URL=https://app.matchday.example
# EAS project id (set by `eas init`), used for Expo push tokens
EXPO_PUBLIC_EAS_PROJECT_ID=
