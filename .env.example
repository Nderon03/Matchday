# Public client configuration (safe to embed in the app). NEVER put service-role or Stripe secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: public web address for shareable invite links, e.g. https://matchday.yourdomain.com
# Leave empty in development: the web app uses the address you're on, the mobile app uses matchday://
EXPO_PUBLIC_APP_URL=
# EAS project id (set by `eas init`), used for Expo push tokens
EXPO_PUBLIC_EAS_PROJECT_ID=
# Crash reporting (Sentry project → Settings → Client Keys). Optional; safe to embed.
EXPO_PUBLIC_SENTRY_DSN=
# Social sign-in buttons, once set up in Supabase → Authentication → Providers (e.g. google,apple). Leave empty for email only.
EXPO_PUBLIC_OAUTH_PROVIDERS=
