# Edge Function secrets: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret(s) of your Stripe webhook destination(s); comma-separate if you have two (your account + connected accounts)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Booking fee paid by players so hosts receive the full price and card processing is covered.
# Grossed up: (amount × rate + fixed) / (1 − rate). Default ≈ UK card fee: 1.5% + 20p (≈35p on £9). Set both to 0 to switch off.
PLAYER_FEE_BPS=150
PLAYER_FEE_FIXED_PENCE=20
# Optional extra fee kept from the host's amount, in basis points (0 = none, 250 = 2.5%)
PLATFORM_FEE_BPS=0
# Deep-link / web URL used for Stripe redirect pages (e.g. https://app.matchday.example or matchday://)
APP_URL=matchday://
ALLOWED_ORIGIN=*
CRON_SECRET=change-me-to-a-long-random-string
# Optional
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=MATCHDAY <noreply@example.com>
